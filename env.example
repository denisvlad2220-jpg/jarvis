ANTHROPIC_API_KEY=
JARVIS_MODEL=claude-sonnet-4-6
JARVIS_API_KEY=cambia-questa-chiave
TIMEZONE=Europe/Rome

# Discord (https://discord.com/developers/applications -> Bot -> abilita "Message Content Intent")
DISCORD_TOKEN=
DISCORD_ALLOWED_USER_IDS=         # tuoi ID separati da virgola: solo loro possono dare ordini

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=scegli-una-parola
WHATSAPP_ALLOWED_NUMBERS=         # es. 393331234567

# Minecraft (server.properties: enable-rcon=true, rcon.password=..., rcon.port=25575)
MC_RCON_HOST=127.0.0.1
MC_RCON_PORT=25575
MC_RCON_PASSWORD=
MC_LOG_PATH=                      # es. /home/user/minecraft/logs/latest.log
MC_ALLOW_DANGEROUS=false

# Dispositivi (Home Assistant -> Profilo -> Token di accesso a lungo termine)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=
